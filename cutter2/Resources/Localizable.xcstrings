    "error.writer.compatibility" : {
      "comment" : "Error when file type or preset is not compatible with movie",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected file type or preset is not compatible with the current movie."
