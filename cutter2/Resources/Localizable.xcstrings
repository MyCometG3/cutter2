        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択されたファイルタイプまたはプリセットは、現在のムービーと互換性がありません。"
          }
        }
      }
    },
    "error.writer.reader_writer_unavailable" : {
      "comment" : "Error when AVAssetReader or AVAssetWriter cannot be created",
