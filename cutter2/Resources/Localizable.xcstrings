        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル拡張子とファイルタイプが一致しません。"
          }
        }
      }
    },
    "error.document.overwrite_self_contained_with_reference" : {
      "comment" : "Error when trying to overwrite self-contained movie with reference movie",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please choose different file name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のファイル名を選択してください。"
          }
        }
      }
    },
    "error.document.internal_error" : {
      "comment" : "Generic internal error message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal error occurred."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部エラーが発生しました。"
          }
        }
      }
    },
    "error.document.modify_capar_failed" : {
      "comment" : "Error when modifying Clean Aperture or Pixel Aspect Ratio extensions fails",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
