{
  "sourceLanguage" : "en",
  "strings" : {
    "error.document.incompatible_file_type" : {
      "comment" : "Error message when file type is incompatible with the application",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompatible file type detected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性のないファイル形式が検出されました。"
          }
        }
      }
    },
    "error.document.unable_to_open_file" : {
      "comment" : "Error when file cannot be opened as AVMovie",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to open specified file as AVMovie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定されたファイルをAVMovieとして開けませんでした。"
          }
        }
      }
    },
    "error.document.empty_movie" : {
      "comment" : "Error when trying to save an empty movie",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty movie cannot be saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のムービーは保存できません。"
          }
        }
      }
    },
    "error.document.unsupported_save_operation" : {
      "comment" : "Error when save operation type is not supported",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsupported SaveOperationType detected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされていない保存操作が検出されました。"
          }
        }
      }
    },
    "error.document.unsupported_file_extension" : {
      "comment" : "Error when file extension is not supported",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsupported file extension is detected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされていないファイル拡張子が検出されました。"
          }
        }
      }
    },
    "error.document.file_type_extension_mismatch" : {
      "comment" : "Error when file extension doesn't match file type",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismatch between file extension and file type."
